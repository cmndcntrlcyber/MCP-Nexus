# MCP-Nexus Bridge Configuration
# This file contains environment variables for connecting to the OpenWebUI bridge

# Primary bridge endpoints
OFFSEC_API_URL=https://offsec-team.attck-community.workers.dev
RESEARCH_MCP_URL=https://research-agent-mcp.attck-community.workers.dev

# Authentication - Configure these with your actual credentials
BRIDGE_BEARER_TOKEN=
BRIDGE_API_KEY=

# Bridge client configuration
BRIDGE_REQUEST_TIMEOUT=30000
BRIDGE_MAX_RETRIES=3
BRIDGE_HEALTH_CHECK_INTERVAL=30000

# Enable/disable specific bridge features
ENABLE_CIRCUIT_BREAKER=true
ENABLE_REQUEST_RETRY=true
ENABLE_HEALTH_MONITORING=true

# Logging and debugging
BRIDGE_DEBUG_MODE=false
BRIDGE_LOG_LEVEL=info

# Workflow orchestration settings
DEFAULT_WORKFLOW_TIMEOUT=300000
MAX_CONCURRENT_WORKFLOWS=5
ENABLE_WORKFLOW_PERSISTENCE=true

# Security settings
ENABLE_REQUEST_VALIDATION=true
ENABLE_RESPONSE_SANITIZATION=true
MAX_REQUEST_SIZE=10485760

# Performance tuning
CONNECTION_POOL_SIZE=10
REQUEST_QUEUE_SIZE=100
RESPONSE_CACHE_TTL=60000

# Agent-specific settings
BUG_HUNTER_ENABLED=true
RT_DEV_ENABLED=true
BURPSUITE_OPERATOR_ENABLED=true
DAEDELU5_ENABLED=true
NEXUS_KAMUY_ENABLED=true

# Fallback and error handling
ENABLE_GRACEFUL_DEGRADATION=true
FALLBACK_TIMEOUT=5000
ERROR_RETRY_DELAY=1000

# Monitoring and metrics
ENABLE_METRICS_COLLECTION=true
METRICS_EXPORT_INTERVAL=60000
HEALTH_CHECK_ENDPOINT=/health

# Development/Testing
MOCK_BRIDGE_RESPONSES=false
ENABLE_REQUEST_LOGGING=false
BYPASS_AUTHENTICATION=false
